# NetGuard AI - Backend Environment Configuration Template
# Copy this file to backend/.env for local overrides

# Application
PROJECT_NAME="NetGuard AI API"
VERSION="v1"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# Database (Defaults to backend/netguard.db when omitted)
# DATABASE_URL="sqlite:///./netguard.db"

# CORS Configuration (Comma-separated list or JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
